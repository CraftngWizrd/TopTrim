{
  "name": "toptrim-v2",
  "version": "2.0.0",
  "description": "TopTrim v2 — a clean, focused, free video editor. No watermark. No subscription. No account. Fully local.",
  "private": true,
  "author": "TopTrim",
  "main": "dist-electron/main.js",
  "scripts": {
    "sync-core": "node scripts/sync-ffmpeg-core.mjs",
    "icons": "node scripts/make-icons.mjs",
    "predev": "npm run sync-core",
    "dev": "vite",
    "prebuild": "npm run sync-core",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@fontsource/dm-sans": "^5.0.20",
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@fontsource/outfit": "^5.0.11",
    "@xenova/transformers": "^2.17.2",
    "ffmpeg-static": "^5.3.0",
    "idb-keyval": "^6.2.1",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/core-mt": "^0.12.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.toptrim.app",
    "productName": "TopTrim",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/ffmpeg-static/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "CraftngWizrd",
      "repo": "TopTrim"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  }
}
